<Window x:Class="Ticketsystem_WPF.TicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ticketsystem_WPF"
        mc:Ignorable="d"
        Title="TicketWindow" Height="538" Width="413">
    <Grid Margin="0,0,0,-6">
        <Label Content="Neues Ticket anlegen" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Label Content="Kunde" HorizontalAlignment="Left" Margin="10,54,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="KundeComboBox" HorizontalAlignment="Left" Margin="119,58,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="KundeComboBox_SelectionChanged"/>
        <Label Content="Datum" HorizontalAlignment="Left" Margin="10,98,0,0" VerticalAlignment="Top"/>
        <Label x:Name="DatumLabel" Content="Label" HorizontalAlignment="Left" Margin="119,98,0,0" VerticalAlignment="Top"/>
        <Label Content="Überschrift" HorizontalAlignment="Left" Margin="10,149,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="UeberschriftTextBox" HorizontalAlignment="Left" Margin="119,149,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="266" Height="30" TextChanged="UeberschriftTextBox_TextChanged"/>
        <Label Content="Beschreibung" HorizontalAlignment="Left" Margin="10,244,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="BeschreibungTextBox" HorizontalAlignment="Left" Margin="119,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="266" Height="107"/>
        <Label Content="Status" HorizontalAlignment="Left" Margin="10,357,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="StatusComboBox" HorizontalAlignment="Left" Margin="119,361,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="StatusComboBox_SelectionChanged" IsEnabled="False"/>
        <Button x:Name="OkButton" Content="Ok" HorizontalAlignment="Left" Margin="57,458,0,0" VerticalAlignment="Top" Width="81" Height="30" Click="Button_Click"/>
        <Button x:Name="AbbrechButton" Content="Abbrechen" HorizontalAlignment="Left" Margin="269,458,0,0" VerticalAlignment="Top" Height="30" Width="81" Click="AbbrechButton_Click"/>
        <Button x:Name="KundeAnlegenButton" Content="Neuer Kunde" HorizontalAlignment="Left" Margin="276,58,0,0" VerticalAlignment="Top" Height="22" Width="74" Click="Button_Click_1"/>


    </Grid>
</Window>

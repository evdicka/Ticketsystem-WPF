<Window x:Class="Ticketsystem_WPF.UI.KundeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ticketsystem_WPF.UI"
        mc:Ignorable="d"
        Title="KundeWindow" Height="450" Width="382">
    <Grid>


        <Label Content="Neuen Kunden anlegen" HorizontalAlignment="Left" Margin="24,10,0,0" VerticalAlignment="Top"/>
        <Label Content="Nachname" HorizontalAlignment="Left" Margin="19,76,0,0" VerticalAlignment="Top"/>
        <Label Content="Vorname" HorizontalAlignment="Left" Margin="19,162,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.476,1.029"/>
        <TextBox x:Name="NachnameTextBox" HorizontalAlignment="Left" Margin="118,76,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="226" Height="31" TextChanged="TextBox_TextChanged"/>
        <TextBox x:Name="VornameTextBox" HorizontalAlignment="Left" Margin="118,159,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="226" Height="31"/>
        <Button x:Name="OkButton" Content="Ok" HorizontalAlignment="Left" Margin="24,335,0,0" VerticalAlignment="Top" Width="93" Height="40" Click="OkButton_Click"/>
        <Button x:Name="AbbrechButton" Content="Abbrechen" HorizontalAlignment="Left" Margin="251,335,0,0" VerticalAlignment="Top" Height="40" Width="93" Click="AbbrechButton_Click"/>


    </Grid>
</Window>
